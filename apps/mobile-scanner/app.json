{
  "expo": {
    "name": "NexaTicket Scanner",
    "slug": "nexaticket-mobile-scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nexaticket-scanner",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.nexaticket.scanner",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "supportsTablet": false
    },
    "android": {
      "package": "com.nexaticket.scanner",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép NexaTicket Scanner dùng camera để quét vé QR.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "20e83433-4f5f-431d-bd4f-77acccde5d51"
      }
    },
    "owner": "hanhphamthi",
    "icon": "./assets/icon.png"
  }
}
