# Một mã nguồn, hai ứng dụng: NexaTicket (khách) và NexaTicket Staff (ban tổ chức + soát vé), chọn
# bằng APP_VARIANT lúc chạy/build (`pnpm start` / `pnpm start:staff`). Sao chép thành `.env.local`.
# Trên thiết bị thật / Expo Go qua LAN, dùng IP LAN của máy chạy backend thay vì localhost.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.18:8080
EXPO_PUBLIC_KEYCLOAK_ISSUER=http://192.168.1.18:8081/realms/nexaticket

# --- Bản khách (NexaTicket) ---
# Client công khai PKCE. Redirect URI bên dưới phải có trong client này; bỏ trống thì app tự lấy
# đúng địa chỉ Expo đang chạy.
EXPO_PUBLIC_MOBILE_OIDC_CLIENT_ID=mobile-customer
EXPO_PUBLIC_OIDC_REDIRECT_URI=

# --- Bản staff (NexaTicket Staff) ---
# Client `mobile-staff`: PKCE cho tài khoản email của ban tổ chức, cộng grant `password` cho đăng
# nhập nhân viên bằng mã PIN. Redirect URI bỏ trống thì app tự lấy (nexaticket-staff://auth hoặc
# exp://…:8083/--/auth trong Expo Go — client đã khai `exp://*`).
EXPO_PUBLIC_STAFF_OIDC_CLIENT_ID=mobile-staff
EXPO_PUBLIC_STAFF_OIDC_REDIRECT_URI=
# Miền email nội bộ của tài khoản nhân viên — phải khớp nexaticket.identity.staff-accounts.login-domain
# của identity-service. Nhân viên chỉ gõ phần trước `@`.
EXPO_PUBLIC_STAFF_LOGIN_DOMAIN=staff.nexaticket.invalid

# Gốc địa chỉ kho ảnh mà điện thoại tới được (vd tunnel trỏ vào MinIO :9000). Bỏ trống khi API là IP LAN.
EXPO_PUBLIC_MEDIA_BASE_URL=
