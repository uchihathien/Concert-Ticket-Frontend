    "@tanstack/react-query": "^5.62.11",
    "expo": "~58.0.19",
    "expo-auth-session": "~58.0.14",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
