# Chuẩn hoá xuống dòng.
* text=auto eol=lf

# Script phải giữ LF tuyệt đối: CRLF làm Linux báo "bad interpreter" và CI hỏng ngay.
*.sh   text eol=lf

# File của Windows thì ngược lại.
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Nhị phân — không đụng vào.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary

# Bớt nhiễu khi review diff.
pnpm-lock.yaml text eol=lf linguist-generated=true -diff
