# Sao chép thành `.env.local` TRONG THƯ MỤC CỦA TỪNG APP, không phải ở gốc repo.
#
#   cp .env.example apps/web-customer/.env.local
#   cp .env.example apps/web-admin/.env.local
#   cp .env.example apps/web-platform/.env.local
#   cp .env.example apps/web-scanner/.env.local
#
# Mỗi app là một tiến trình Next riêng và đọc `.env.local` ở thư mục của chính nó, nên bốn app
# dùng chung tên biến mà không đụng nhau. KHÔNG commit `.env.local`.

# --- Auth.js ---
# Khoá ký/mã hoá cookie phiên. Mỗi môi trường một giá trị; sinh bằng: openssl rand -base64 32
AUTH_SECRET=doi-gia-tri-nay-o-moi-moi-truong

# URL gốc của chính app này. Quyết định callback OIDC và tiền tố cookie (__Secure- khi https).
# web-customer 3000 · web-admin 3001 · web-scanner 3002 · web-platform 3003
AUTH_URL=http://localhost:3000

# --- Keycloak ---
# Bốn client riêng cho bốn app (plan/frontend.md §4). CLIENT_ID bỏ trống thì lấy theo tên app.
KEYCLOAK_ISSUER=http://localhost:8081/realms/nexaticket
KEYCLOAK_CLIENT_ID=web-customer
KEYCLOAK_CLIENT_SECRET=dev-secret-customer

# Có hiện nút "Tiếp tục với Google" hay không. Không phải NEXT_PUBLIC_: đây là quyết định hiển
# thị ở phía server, client không cần tự suy ra.
#
# Chỉ bật SAU KHI đã chạy `./scripts/setup-google-idp.sh` để khai identity provider trong
# Keycloak. Bật sớm thì người dùng bấm nút và nhận trang lỗi của Keycloak.
AUTH_GOOGLE_ENABLED=false

# --- Backend ---
# api-gateway. Biến NEXT_PUBLIC_ nên giá trị này lộ ra bundle phía client — đúng như mong muốn,
# vì trình duyệt phải biết gọi đi đâu. Đừng đặt secret nào có tiền tố NEXT_PUBLIC_.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
